{
  "telemetry": "DESKTOP_CONTROL=1 TELEMETRY_MODE=verified uv run agent.py {instruction}",
  "claude-code": "claude -p {instruction} --output-format json --allowedTools Bash",
  "claude-code-gui": "claude -p {instruction} --output-format json --strict-mcp-config --mcp-config evals/desktop/computer-mcp.json --disallowedTools Bash",
  "codex": "codex exec --skip-git-repo-check --dangerously-bypass-approvals-and-sandbox {instruction}",
  "telemetry-screenshot": "DESKTOP_CONTROL=1 TELEMETRY_MODE=screenshot uv run agent.py {instruction}",
  "telemetry-flat": "DESKTOP_CONTROL=1 TELEMETRY_MODE=flat uv run agent.py {instruction}",
  "telemetry-graph": "DESKTOP_CONTROL=1 TELEMETRY_MODE=graph uv run agent.py {instruction}"
}
